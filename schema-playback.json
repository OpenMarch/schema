{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"ompbVersion": {
			"type": "string",
			"pattern": "^0\\.1\\.\\d+$"
		},
		"ticksPerBeat": {
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991
		},
		"metadata": {
			"type": "object",
			"properties": {
				"createdAtUtc": {
					"type": "string"
				},
				"audioOffsetSeconds": {
					"type": "number"
				},
				"info": {
					"type": "object",
					"properties": {
						"title": {
							"type": "string"
						},
						"author": {
							"type": "string"
						},
						"school": {
							"type": "string"
						},
						"year": {
							"type": "string"
						}
					},
					"additionalProperties": {}
				},
				"performanceArea": {
					"type": "object",
					"properties": {
						"yOrigin": {
							"type": "string",
							"enum": ["front", "center"]
						},
						"inchesPerStep": {
							"type": "number",
							"exclusiveMinimum": 0
						},
						"xCheckpoints": {
							"type": "array",
							"items": {
								"type": "object",
								"properties": {
									"name": {
										"type": "string"
									},
									"terseName": {
										"type": "string"
									},
									"useAsReference": {
										"type": "boolean"
									},
									"fieldLabel": {
										"type": "string"
									},
									"visible": {
										"type": "boolean"
									},
									"stepsFromCenter": {
										"type": "number"
									}
								},
								"required": [
									"name",
									"terseName",
									"useAsReference",
									"visible",
									"stepsFromCenter"
								]
							}
						},
						"yCheckpoints": {
							"type": "array",
							"items": {
								"type": "object",
								"properties": {
									"name": {
										"type": "string"
									},
									"terseName": {
										"type": "string"
									},
									"useAsReference": {
										"type": "boolean"
									},
									"fieldLabel": {
										"type": "string"
									},
									"visible": {
										"type": "boolean"
									},
									"stepsFromYOrigin": {
										"type": "number"
									}
								},
								"required": [
									"name",
									"terseName",
									"useAsReference",
									"visible",
									"stepsFromYOrigin"
								]
							}
						},
						"widthFeet": {
							"type": "number"
						},
						"heightFeet": {
							"type": "number"
						},
						"useHashes": {
							"type": "boolean"
						}
					},
					"required": [
						"yOrigin",
						"inchesPerStep",
						"xCheckpoints",
						"yCheckpoints",
						"widthFeet",
						"heightFeet",
						"useHashes"
					]
				}
			},
			"required": ["createdAtUtc", "performanceArea"]
		},
		"performers": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"label": {
						"type": "string"
					},
					"section": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"notes": {
						"type": "string"
					}
				},
				"required": ["id", "label", "section"]
			}
		},
		"performerAppearance": {
			"type": "object",
			"properties": {
				"defaultAppearance": {
					"type": "object",
					"properties": {
						"fillRgba": {
							"type": "string",
							"pattern": "^rgba\\(\\d{1,3},\\d{1,3},\\d{1,3},(?:0(?:\\.\\d+)?|1(?:\\.0+)?)\\)$"
						},
						"strokeRgba": {
							"type": "string",
							"pattern": "^rgba\\(\\d{1,3},\\d{1,3},\\d{1,3},(?:0(?:\\.\\d+)?|1(?:\\.0+)?)\\)$"
						},
						"strokeWidth": {
							"type": "number",
							"minimum": 0
						},
						"visible": {
							"type": "boolean"
						},
						"textVisible": {
							"type": "boolean"
						},
						"shape": {
							"type": "string"
						}
					},
					"required": [
						"fillRgba",
						"strokeRgba",
						"strokeWidth",
						"visible",
						"textVisible",
						"shape"
					]
				},
				"performers": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"fillRgba": {
								"type": "string",
								"pattern": "^rgba\\(\\d{1,3},\\d{1,3},\\d{1,3},(?:0(?:\\.\\d+)?|1(?:\\.0+)?)\\)$"
							},
							"strokeRgba": {
								"type": "string",
								"pattern": "^rgba\\(\\d{1,3},\\d{1,3},\\d{1,3},(?:0(?:\\.\\d+)?|1(?:\\.0+)?)\\)$"
							},
							"strokeWidth": {
								"type": "number",
								"minimum": 0
							},
							"visible": {
								"type": "boolean"
							},
							"textVisible": {
								"type": "boolean"
							},
							"shape": {
								"type": "string"
							},
							"marcherId": {
								"type": "string"
							},
							"pageId": {
								"type": "string"
							}
						},
						"required": [
							"fillRgba",
							"strokeRgba",
							"strokeWidth",
							"visible",
							"textVisible",
							"shape",
							"marcherId",
							"pageId"
						]
					}
				},
				"sections": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"fillRgba": {
								"type": "string",
								"pattern": "^rgba\\(\\d{1,3},\\d{1,3},\\d{1,3},(?:0(?:\\.\\d+)?|1(?:\\.0+)?)\\)$"
							},
							"strokeRgba": {
								"type": "string",
								"pattern": "^rgba\\(\\d{1,3},\\d{1,3},\\d{1,3},(?:0(?:\\.\\d+)?|1(?:\\.0+)?)\\)$"
							},
							"strokeWidth": {
								"type": "number",
								"minimum": 0
							},
							"visible": {
								"type": "boolean"
							},
							"textVisible": {
								"type": "boolean"
							},
							"shape": {
								"type": "string"
							},
							"section": {
								"type": "string"
							}
						},
						"required": [
							"fillRgba",
							"strokeRgba",
							"strokeWidth",
							"visible",
							"textVisible",
							"shape",
							"section"
						]
					}
				}
			}
		},
		"tempoSections": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"tempo": {
						"type": "number",
						"exclusiveMinimum": 0
					},
					"numberOfBeats": {
						"type": "integer",
						"exclusiveMinimum": 0,
						"maximum": 9007199254740991
					}
				},
				"required": ["tempo", "numberOfBeats"]
			}
		},
		"measures": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"startBeatIndex": {
						"type": "integer",
						"minimum": 0,
						"maximum": 9007199254740991
					},
					"name": {
						"type": "string"
					},
					"rehearsalMark": {
						"type": "string"
					}
				},
				"required": ["startBeatIndex", "name"]
			}
		},
		"pages": {
			"minItems": 1,
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"startBeatIndex": {
						"type": "integer",
						"minimum": 0,
						"maximum": 9007199254740991
					},
					"counts": {
						"type": "integer",
						"minimum": 0,
						"maximum": 9007199254740991
					},
					"isSubset": {
						"type": "boolean"
					},
					"paths": {
						"type": "object",
						"propertyNames": {
							"type": "string"
						},
						"additionalProperties": {
							"type": "string",
							"pattern": "^M -?\\d+(?:\\.\\d+)? -?\\d+(?:\\.\\d+)?(?: (?:L -?\\d+(?:\\.\\d+)? -?\\d+(?:\\.\\d+)?|C -?\\d+(?:\\.\\d+)? -?\\d+(?:\\.\\d+)? -?\\d+(?:\\.\\d+)? -?\\d+(?:\\.\\d+)? -?\\d+(?:\\.\\d+)? -?\\d+(?:\\.\\d+)?))*$"
						}
					}
				},
				"required": ["id", "name", "startBeatIndex", "counts", "paths"]
			}
		},
		"moves": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"marcherId": {
						"type": "string"
					},
					"ticksPerStep": {
						"type": "integer",
						"exclusiveMinimum": 0,
						"maximum": 9007199254740991
					},
					"ticks": {
						"minItems": 2,
						"type": "array",
						"items": {
							"type": "integer",
							"minimum": 0,
							"maximum": 9007199254740991
						}
					},
					"xy": {
						"type": "array",
						"items": {
							"type": "number"
						}
					}
				},
				"required": ["marcherId", "ticks", "xy"]
			}
		}
	},
	"required": [
		"ompbVersion",
		"ticksPerBeat",
		"metadata",
		"performers",
		"tempoSections",
		"pages",
		"moves"
	]
}
