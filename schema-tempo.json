{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"omSchemaVersion": {
			"default": "0.3.0",
			"type": "string"
		},
		"metadata": {
			"type": "object",
			"properties": {
				"createdAtUtc": {
					"type": "string"
				},
				"audioOffsetSeconds": {
					"type": "number"
				},
				"info": {
					"type": "object",
					"properties": {
						"title": {
							"type": "string"
						},
						"author": {
							"type": "string"
						},
						"school": {
							"type": "string"
						},
						"year": {
							"type": "string"
						}
					},
					"additionalProperties": {}
				}
			},
			"required": ["createdAtUtc"]
		},
		"pages": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"duration": {
						"type": "number"
					},
					"startBeatIndex": {
						"type": "number"
					},
					"isSubset": {
						"type": "boolean"
					},
					"name": {
						"type": "string"
					}
				},
				"required": ["id", "duration", "startBeatIndex", "name"],
				"additionalProperties": false
			}
		},
		"tempoSections": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"tempo": {
						"type": "number"
					},
					"numberOfBeats": {
						"type": "number"
					}
				},
				"required": ["tempo", "numberOfBeats"],
				"additionalProperties": false
			}
		},
		"measures": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"startBeatIndex": {
						"type": "number"
					},
					"name": {
						"type": "string"
					},
					"rehearsalMark": {
						"type": "string"
					}
				},
				"required": ["startBeatIndex", "name"],
				"additionalProperties": false
			}
		}
	},
	"required": ["omSchemaVersion", "metadata", "pages", "tempoSections"]
}
