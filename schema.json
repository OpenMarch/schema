{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"omSchemaVersion": {
			"default": "0.3.0",
			"type": "string"
		},
		"metadata": {
			"type": "object",
			"properties": {
				"createdAtUtc": {
					"type": "string"
				},
				"audioOffsetSeconds": {
					"type": "number"
				},
				"info": {
					"type": "object",
					"properties": {
						"title": {
							"type": "string"
						},
						"author": {
							"type": "string"
						},
						"school": {
							"type": "string"
						},
						"year": {
							"type": "string"
						}
					},
					"additionalProperties": {}
				},
				"performanceArea": {
					"type": "object",
					"properties": {
						"yOrigin": {
							"type": "string",
							"enum": ["front", "center"]
						},
						"inchesPerStep": {
							"type": "number"
						},
						"xCheckpoints": {
							"type": "array",
							"items": {
								"type": "object",
								"properties": {
									"name": {
										"type": "string"
									},
									"terseName": {
										"type": "string"
									},
									"useAsReference": {
										"type": "boolean"
									},
									"fieldLabel": {
										"type": "string"
									},
									"visible": {
										"type": "boolean"
									},
									"stepsFromCenter": {
										"type": "number"
									}
								},
								"required": [
									"name",
									"terseName",
									"useAsReference",
									"visible",
									"stepsFromCenter"
								],
								"additionalProperties": false
							}
						},
						"yCheckpoints": {
							"type": "array",
							"items": {
								"type": "object",
								"properties": {
									"name": {
										"type": "string"
									},
									"terseName": {
										"type": "string"
									},
									"useAsReference": {
										"type": "boolean"
									},
									"fieldLabel": {
										"type": "string"
									},
									"visible": {
										"type": "boolean"
									},
									"stepsFromYOrigin": {
										"type": "number"
									}
								},
								"required": [
									"name",
									"terseName",
									"useAsReference",
									"visible",
									"stepsFromYOrigin"
								],
								"additionalProperties": false
							}
						},
						"widthFeet": {
							"type": "number"
						},
						"heightFeet": {
							"type": "number"
						},
						"useHashes": {
							"type": "boolean"
						}
					},
					"required": [
						"yOrigin",
						"inchesPerStep",
						"xCheckpoints",
						"yCheckpoints",
						"widthFeet",
						"heightFeet",
						"useHashes"
					],
					"additionalProperties": false
				}
			},
			"required": ["createdAtUtc", "performanceArea"],
			"additionalProperties": false
		},
		"performers": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "number"
					},
					"label": {
						"type": "string"
					},
					"section": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"notes": {
						"type": "string"
					}
				},
				"required": ["id", "label", "section"],
				"additionalProperties": false
			}
		},
		"performerAppearance": {
			"type": "object",
			"properties": {
				"defaultAppearance": {
					"type": "object",
					"properties": {
						"fillRgba": {
							"type": "string",
							"pattern": "^rgba\\(\\d{1,3},\\d{1,3},\\d{1,3},(?:0(?:\\.\\d+)?|1(?:\\.0+)?)\\)$"
						},
						"strokeRgba": {
							"type": "string",
							"pattern": "^rgba\\(\\d{1,3},\\d{1,3},\\d{1,3},(?:0(?:\\.\\d+)?|1(?:\\.0+)?)\\)$"
						},
						"strokeWidth": {
							"default": 1,
							"type": "number",
							"exclusiveMinimum": 0
						},
						"visible": {
							"default": true,
							"type": "boolean"
						},
						"textVisible": {
							"default": true,
							"type": "boolean"
						},
						"shape": {
							"type": "string",
							"enum": ["circle", "square", "triangle", "cross"]
						}
					},
					"required": [
						"fillRgba",
						"strokeRgba",
						"strokeWidth",
						"visible",
						"textVisible",
						"shape"
					],
					"additionalProperties": false
				},
				"performers": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"fillRgba": {
								"type": "string",
								"pattern": "^rgba\\(\\d{1,3},\\d{1,3},\\d{1,3},(?:0(?:\\.\\d+)?|1(?:\\.0+)?)\\)$"
							},
							"strokeRgba": {
								"type": "string",
								"pattern": "^rgba\\(\\d{1,3},\\d{1,3},\\d{1,3},(?:0(?:\\.\\d+)?|1(?:\\.0+)?)\\)$"
							},
							"strokeWidth": {
								"default": 1,
								"type": "number",
								"exclusiveMinimum": 0
							},
							"visible": {
								"default": true,
								"type": "boolean"
							},
							"textVisible": {
								"default": true,
								"type": "boolean"
							},
							"shape": {
								"type": "string",
								"enum": ["circle", "square", "triangle", "cross"]
							},
							"marcherId": {
								"type": "string"
							},
							"pageId": {
								"type": "string"
							}
						},
						"required": [
							"fillRgba",
							"strokeRgba",
							"strokeWidth",
							"visible",
							"textVisible",
							"shape",
							"marcherId",
							"pageId"
						],
						"additionalProperties": false
					}
				},
				"sections": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"fillRgba": {
								"type": "string",
								"pattern": "^rgba\\(\\d{1,3},\\d{1,3},\\d{1,3},(?:0(?:\\.\\d+)?|1(?:\\.0+)?)\\)$"
							},
							"strokeRgba": {
								"type": "string",
								"pattern": "^rgba\\(\\d{1,3},\\d{1,3},\\d{1,3},(?:0(?:\\.\\d+)?|1(?:\\.0+)?)\\)$"
							},
							"strokeWidth": {
								"default": 1,
								"type": "number",
								"exclusiveMinimum": 0
							},
							"visible": {
								"default": true,
								"type": "boolean"
							},
							"textVisible": {
								"default": true,
								"type": "boolean"
							},
							"shape": {
								"type": "string",
								"enum": ["circle", "square", "triangle", "cross"]
							},
							"section": {
								"type": "string"
							}
						},
						"required": [
							"fillRgba",
							"strokeRgba",
							"strokeWidth",
							"visible",
							"textVisible",
							"shape",
							"section"
						],
						"additionalProperties": false
					}
				}
			},
			"additionalProperties": false
		},
		"pages": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"duration": {
						"type": "number"
					},
					"startBeatIndex": {
						"type": "number"
					},
					"isSubset": {
						"type": "boolean"
					},
					"name": {
						"type": "string"
					}
				},
				"required": ["id", "duration", "startBeatIndex", "name"],
				"additionalProperties": false
			}
		},
		"tempoSections": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"tempo": {
						"type": "number"
					},
					"numberOfBeats": {
						"type": "number"
					}
				},
				"required": ["tempo", "numberOfBeats"],
				"additionalProperties": false
			}
		},
		"coordinates": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"marcherId": {
						"type": "string"
					},
					"pageId": {
						"type": "string"
					},
					"xSteps": {
						"type": "number"
					},
					"ySteps": {
						"type": "number"
					},
					"rotation_degrees": {
						"type": "number"
					}
				},
				"required": ["marcherId", "pageId", "xSteps", "ySteps"],
				"additionalProperties": false
			}
		},
		"measures": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"startBeatIndex": {
						"type": "number"
					},
					"name": {
						"type": "string"
					},
					"rehearsalMark": {
						"type": "string"
					}
				},
				"required": ["startBeatIndex", "name"],
				"additionalProperties": false
			}
		},
		"exactPaths": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"marcherId": {
						"type": "string",
						"description": "The marcher who walks it: the same ids as coordinates"
					},
					"startTick": {
						"type": "integer",
						"minimum": 0,
						"description": "When the move starts: whole ticks from the start of the show, 480 per beat, on the same beat scale as startBeatIndex (beat b is tick b × 480). The path's key ticks count from here (EP-P1)"
					},
					"endTick": {
						"type": "integer",
						"minimum": 0,
						"description": "When the move ends: startTick plus the path's last key tick (EP-P2)"
					},
					"path": {
						"type": "object",
						"properties": {
							"v": {
								"type": "number",
								"const": 1
							},
							"from": {
								"type": "array",
								"prefixItems": [
									{
										"type": "number"
									},
									{
										"type": "number"
									}
								],
								"minItems": 2,
								"maxItems": 2,
								"items": false,
								"description": "Where the walk starts, [x, y] in steps"
							},
							"shapes": {
								"type": "array",
								"items": {
									"oneOf": [
										{
											"type": "object",
											"properties": {
												"kind": {
													"type": "string",
													"const": "points"
												},
												"points": {
													"type": "array",
													"items": {
														"type": "array",
														"prefixItems": [
															{
																"type": "number"
															},
															{
																"type": "number"
															}
														],
														"minItems": 2,
														"maxItems": 2,
														"items": false,
														"description": "[x, y] in steps"
													},
													"minItems": 1,
													"description": "Straight lines through these points: each is a corner, the last is the shape's end (EP-2)"
												}
											},
											"required": ["kind", "points"],
											"additionalProperties": false
										},
										{
											"type": "object",
											"properties": {
												"kind": {
													"type": "string",
													"const": "arc"
												},
												"to": {
													"type": "array",
													"prefixItems": [
														{
															"type": "number"
														},
														{
															"type": "number"
														}
													],
													"minItems": 2,
													"maxItems": 2,
													"items": false,
													"description": "[x, y] in steps"
												},
												"bend": {
													"type": "number",
													"minimum": -0.5,
													"maximum": 0.5,
													"not": {
														"const": 0
													},
													"description": "Signed sagitta over chord, 0 < |bend| ≤ 1/2 (EP-3). The arc's middle is M + bend·c·n: M the chord's midpoint, c its length, n = (−dy, dx)/c the chord direction turned +90°. With .om's y up the field, a positive bend on a chord along +x bows toward the back. In a y-down system (OpenMarch on screen, SVG), negate bend along with y."
												}
											},
											"required": ["kind", "to", "bend"],
											"additionalProperties": false
										},
										{
											"type": "object",
											"properties": {
												"kind": {
													"type": "string",
													"const": "cubic"
												},
												"c1": {
													"type": "array",
													"prefixItems": [
														{
															"type": "number"
														},
														{
															"type": "number"
														}
													],
													"minItems": 2,
													"maxItems": 2,
													"items": false,
													"description": "[x, y] in steps"
												},
												"c2": {
													"type": "array",
													"prefixItems": [
														{
															"type": "number"
														},
														{
															"type": "number"
														}
													],
													"minItems": 2,
													"maxItems": 2,
													"items": false,
													"description": "[x, y] in steps"
												},
												"to": {
													"type": "array",
													"prefixItems": [
														{
															"type": "number"
														},
														{
															"type": "number"
														}
													],
													"minItems": 2,
													"maxItems": 2,
													"items": false,
													"description": "[x, y] in steps"
												}
											},
											"required": ["kind", "c1", "c2", "to"],
											"additionalProperties": false
										}
									]
								},
								"minItems": 1,
								"description": "Each shape starts where the last one ended (EP-2)"
							},
							"keys": {
								"type": "array",
								"items": {
									"type": "object",
									"properties": {
										"tick": {
											"type": "integer",
											"minimum": 0,
											"description": "Whole ticks from the move's start, 480 per beat (EP-5)"
										},
										"u": {
											"type": "number",
											"minimum": 0,
											"description": "The place: piece number plus the share of that piece's length, 0 to the piece count (EP-5)"
										}
									},
									"required": ["tick", "u"],
									"additionalProperties": false
								},
								"minItems": 2,
								"description": "Timing: first {tick: 0, u: 0}, last u is the piece count, ticks strictly increase, u never decreases; steady speed between keys (EP-5)"
							}
						},
						"required": ["v", "from", "shapes", "keys"],
						"additionalProperties": false
					}
				},
				"required": ["marcherId", "startTick", "endTick", "path"],
				"additionalProperties": false
			},
			"description": "Exact paths: a marcher's real walk during a move, placed by start and end tick. In a page (the walk into a set) with an exact path for the marcher, the marcher follows it and stands still on the page's other counts; in a page without one, it walks a straight line between sets. Coordinates are steps on the same axes as coordinates (y up the field). Rules EP-1 to EP-6 and EP-P1 to EP-P3 apply; see the README."
		}
	},
	"required": [
		"omSchemaVersion",
		"metadata",
		"performers",
		"pages",
		"tempoSections",
		"coordinates"
	]
}
