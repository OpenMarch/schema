{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"omSchemaVersion": {
			"default": "0.3.0",
			"type": "string"
		},
		"metadata": {
			"type": "object",
			"properties": {
				"createdAtUtc": {
					"type": "string"
				},
				"audioOffsetSeconds": {
					"type": "number"
				},
				"info": {
					"type": "object",
					"properties": {
						"title": {
							"type": "string"
						},
						"author": {
							"type": "string"
						},
						"school": {
							"type": "string"
						},
						"year": {
							"type": "string"
						}
					},
					"additionalProperties": {}
				},
				"performanceArea": {
					"type": "object",
					"properties": {
						"yOrigin": {
							"type": "string",
							"enum": ["front", "center"]
						},
						"inchesPerStep": {
							"type": "number"
						},
						"xCheckpoints": {
							"type": "array",
							"items": {
								"type": "object",
								"properties": {
									"name": {
										"type": "string"
									},
									"terseName": {
										"type": "string"
									},
									"useAsReference": {
										"type": "boolean"
									},
									"fieldLabel": {
										"type": "string"
									},
									"visible": {
										"type": "boolean"
									},
									"stepsFromCenter": {
										"type": "number"
									}
								},
								"required": [
									"name",
									"terseName",
									"useAsReference",
									"visible",
									"stepsFromCenter"
								],
								"additionalProperties": false
							}
						},
						"yCheckpoints": {
							"type": "array",
							"items": {
								"type": "object",
								"properties": {
									"name": {
										"type": "string"
									},
									"terseName": {
										"type": "string"
									},
									"useAsReference": {
										"type": "boolean"
									},
									"fieldLabel": {
										"type": "string"
									},
									"visible": {
										"type": "boolean"
									},
									"stepsFromYOrigin": {
										"type": "number"
									}
								},
								"required": [
									"name",
									"terseName",
									"useAsReference",
									"visible",
									"stepsFromYOrigin"
								],
								"additionalProperties": false
							}
						},
						"widthFeet": {
							"type": "number"
						},
						"heightFeet": {
							"type": "number"
						},
						"useHashes": {
							"type": "boolean"
						}
					},
					"required": [
						"yOrigin",
						"inchesPerStep",
						"xCheckpoints",
						"yCheckpoints",
						"widthFeet",
						"heightFeet",
						"useHashes"
					],
					"additionalProperties": false
				}
			},
			"required": ["createdAtUtc", "performanceArea"],
			"additionalProperties": false
		},
		"performers": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "number"
					},
					"label": {
						"type": "string"
					},
					"section": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"notes": {
						"type": "string"
					}
				},
				"required": ["id", "label", "section"],
				"additionalProperties": false
			}
		},
		"performerAppearance": {
			"type": "object",
			"properties": {
				"defaultAppearance": {
					"type": "object",
					"properties": {
						"fillRgba": {
							"type": "string",
							"pattern": "^rgba\\(\\d{1,3},\\d{1,3},\\d{1,3},(?:0(?:\\.\\d+)?|1(?:\\.0+)?)\\)$"
						},
						"strokeRgba": {
							"type": "string",
							"pattern": "^rgba\\(\\d{1,3},\\d{1,3},\\d{1,3},(?:0(?:\\.\\d+)?|1(?:\\.0+)?)\\)$"
						},
						"strokeWidth": {
							"default": 1,
							"type": "number",
							"exclusiveMinimum": 0
						},
						"visible": {
							"default": true,
							"type": "boolean"
						},
						"textVisible": {
							"default": true,
							"type": "boolean"
						},
						"shape": {
							"type": "string",
							"enum": ["circle", "square", "triangle", "cross"]
						}
					},
					"required": [
						"fillRgba",
						"strokeRgba",
						"strokeWidth",
						"visible",
						"textVisible",
						"shape"
					],
					"additionalProperties": false
				},
				"performers": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"fillRgba": {
								"type": "string",
								"pattern": "^rgba\\(\\d{1,3},\\d{1,3},\\d{1,3},(?:0(?:\\.\\d+)?|1(?:\\.0+)?)\\)$"
							},
							"strokeRgba": {
								"type": "string",
								"pattern": "^rgba\\(\\d{1,3},\\d{1,3},\\d{1,3},(?:0(?:\\.\\d+)?|1(?:\\.0+)?)\\)$"
							},
							"strokeWidth": {
								"default": 1,
								"type": "number",
								"exclusiveMinimum": 0
							},
							"visible": {
								"default": true,
								"type": "boolean"
							},
							"textVisible": {
								"default": true,
								"type": "boolean"
							},
							"shape": {
								"type": "string",
								"enum": ["circle", "square", "triangle", "cross"]
							},
							"marcherId": {
								"type": "string"
							},
							"pageId": {
								"type": "string"
							}
						},
						"required": [
							"fillRgba",
							"strokeRgba",
							"strokeWidth",
							"visible",
							"textVisible",
							"shape",
							"marcherId",
							"pageId"
						],
						"additionalProperties": false
					}
				},
				"sections": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"fillRgba": {
								"type": "string",
								"pattern": "^rgba\\(\\d{1,3},\\d{1,3},\\d{1,3},(?:0(?:\\.\\d+)?|1(?:\\.0+)?)\\)$"
							},
							"strokeRgba": {
								"type": "string",
								"pattern": "^rgba\\(\\d{1,3},\\d{1,3},\\d{1,3},(?:0(?:\\.\\d+)?|1(?:\\.0+)?)\\)$"
							},
							"strokeWidth": {
								"default": 1,
								"type": "number",
								"exclusiveMinimum": 0
							},
							"visible": {
								"default": true,
								"type": "boolean"
							},
							"textVisible": {
								"default": true,
								"type": "boolean"
							},
							"shape": {
								"type": "string",
								"enum": ["circle", "square", "triangle", "cross"]
							},
							"section": {
								"type": "string"
							}
						},
						"required": [
							"fillRgba",
							"strokeRgba",
							"strokeWidth",
							"visible",
							"textVisible",
							"shape",
							"section"
						],
						"additionalProperties": false
					}
				}
			},
			"additionalProperties": false
		},
		"pages": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"duration": {
						"type": "number"
					},
					"startBeatIndex": {
						"type": "number"
					},
					"isSubset": {
						"type": "boolean"
					},
					"name": {
						"type": "string"
					}
				},
				"required": ["id", "duration", "startBeatIndex", "name"],
				"additionalProperties": false
			}
		},
		"tempoSections": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"tempo": {
						"type": "number"
					},
					"numberOfBeats": {
						"type": "number"
					}
				},
				"required": ["tempo", "numberOfBeats"],
				"additionalProperties": false
			}
		},
		"coordinates": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"marcherId": {
						"type": "string"
					},
					"pageId": {
						"type": "string"
					},
					"xSteps": {
						"type": "number"
					},
					"ySteps": {
						"type": "number"
					},
					"rotation_degrees": {
						"type": "number"
					}
				},
				"required": ["marcherId", "pageId", "xSteps", "ySteps"],
				"additionalProperties": false
			}
		},
		"measures": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"startBeatIndex": {
						"type": "number"
					},
					"name": {
						"type": "string"
					},
					"rehearsalMark": {
						"type": "string"
					}
				},
				"required": ["startBeatIndex", "name"],
				"additionalProperties": false
			}
		},
		"exactPaths": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"marcherId": {
						"type": "string"
					},
					"startTick": {
						"type": "number"
					},
					"endTick": {
						"type": "number"
					},
					"path": {
						"type": "object",
						"properties": {
							"v": {
								"type": "number",
								"const": 1
							},
							"from": {
								"type": "array",
								"prefixItems": [
									{
										"type": "number"
									},
									{
										"type": "number"
									}
								]
							},
							"shapes": {
								"type": "array",
								"items": {
									"oneOf": [
										{
											"type": "object",
											"properties": {
												"kind": {
													"type": "string",
													"const": "points"
												},
												"points": {
													"type": "array",
													"items": {
														"type": "array",
														"prefixItems": [
															{
																"type": "number"
															},
															{
																"type": "number"
															}
														]
													}
												}
											},
											"required": ["kind", "points"],
											"additionalProperties": false
										},
										{
											"type": "object",
											"properties": {
												"kind": {
													"type": "string",
													"const": "arc"
												},
												"to": {
													"type": "array",
													"prefixItems": [
														{
															"type": "number"
														},
														{
															"type": "number"
														}
													]
												},
												"bend": {
													"type": "number"
												}
											},
											"required": ["kind", "to", "bend"],
											"additionalProperties": false
										},
										{
											"type": "object",
											"properties": {
												"kind": {
													"type": "string",
													"const": "cubic"
												},
												"c1": {
													"type": "array",
													"prefixItems": [
														{
															"type": "number"
														},
														{
															"type": "number"
														}
													]
												},
												"c2": {
													"type": "array",
													"prefixItems": [
														{
															"type": "number"
														},
														{
															"type": "number"
														}
													]
												},
												"to": {
													"type": "array",
													"prefixItems": [
														{
															"type": "number"
														},
														{
															"type": "number"
														}
													]
												}
											},
											"required": ["kind", "c1", "c2", "to"],
											"additionalProperties": false
										}
									]
								}
							},
							"keys": {
								"type": "array",
								"items": {
									"type": "object",
									"properties": {
										"tick": {
											"type": "number"
										},
										"u": {
											"type": "number"
										}
									},
									"required": ["tick", "u"],
									"additionalProperties": false
								}
							}
						},
						"required": ["v", "from", "shapes", "keys"],
						"additionalProperties": false
					}
				},
				"required": ["marcherId", "startTick", "endTick", "path"],
				"additionalProperties": false
			}
		}
	},
	"required": [
		"omSchemaVersion",
		"metadata",
		"performers",
		"pages",
		"tempoSections",
		"coordinates"
	],
	"additionalProperties": false
}
